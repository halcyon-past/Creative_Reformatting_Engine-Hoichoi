# ------------------------------------------------------------------ local ---
CRE_ENV=local
CRE_DEBUG=true
CRE_STORAGE_BACKEND=local          # local | s3
CRE_QUEUE_BACKEND=inmemory         # inmemory | sqs
CRE_REPOSITORY_BACKEND=sqlite      # sqlite | dynamodb
CRE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --------------------------------------------------------------- pipeline ---
CRE_ANALYSIS_FPS=10                # detection rate; rendering is always full-rate
CRE_REEL_TARGET_SECONDS=30         # upper bound on the generated reel
CRE_MAX_REEL_SOURCE_SECONDS=90     # how much of a long master to analyse
CRE_FACE_MIN_CONFIDENCE=0.6
CRE_WORKER_CONCURRENCY=2
CRE_KEEP_QUARANTINED=true          # keep failed renders for inspection

# -------------------------------------------------------------------- aws ---
# Set these and flip the backends above to move to AWS. No code changes.
# CRE_AWS_REGION=ap-south-1
# CRE_S3_BUCKET=hoichoi-cre-media
# CRE_S3_PREFIX=cre/
# CRE_SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/cre-jobs
# CRE_DATABASE_URL=postgresql+asyncpg://user:pass@aurora-host:5432/cre
# CRE_MODEL_DIR=/opt/cre/models
# CRE_ALLOW_MODEL_DOWNLOAD=0       # models are baked into the image

# -------------------------------------------------------------- audit ------
# Trailing X-Forwarded-For hops added by infrastructure you control.
# 0 = ignore the header (correct locally); 1 = behind one ALB; 2 = CloudFront+ALB.
# Too high and a caller can forge the address recorded against their upload.
CRE_TRUSTED_PROXY_HOPS=0
# Audit rows hold IP addresses (personal data). Purged past this age on startup.
CRE_AUDIT_RETENTION_DAYS=90
CRE_AUDIT_JOB_EVENTS=true
